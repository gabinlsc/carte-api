{
  "name": "carte-api",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "scripts": {
    "dev": "node --import tsx --watch src/server.ts",
    "build": "tsc && node scripts/copy-assets.mjs",
    "start": "node --env-file-if-exists=.env dist/server.js",
    "test": "node --import tsx --test tests/*.test.ts",
    "lint": "eslint src tests scripts e2e playwright.config.ts public/*.js",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "user:create": "node --import tsx scripts/create-user.ts",
    "import:legacy": "node --import tsx scripts/import-legacy.ts",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "compression": "^1.8.2",
    "dotenv": "^18.0.5",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "leaflet": "^1.9.4",
    "leaflet.markercluster": "^1.5.3",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.55.1",
    "@types/compression": "^1.8.1",
    "@types/express": "^5.0.6",
    "@types/leaflet": "^1.9.22",
    "@types/leaflet.markercluster": "^1.5.6",
    "@types/node": "^26.6.4",
    "@types/supertest": "^7.2.1",
    "eslint": "^10.11.0",
    "prettier": "^3.9.9",
    "supertest": "^7.3.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.0"
  }
}
