NODE_ENV=development
PORT=3000
DATABASE_PATH=data/carte.sqlite
PUBLIC_ORIGIN=http://localhost:3000
# At least 32 random characters; required in production. Never expose in client source.
API_KEY=
OPENWEATHER_API_KEY=
WEATHER_TIMEOUT_MS=4000
CACHE_TTL_MS=30000
# Number of trusted reverse proxy hops; leave 0 for a direct connection.
TRUST_PROXY=0
